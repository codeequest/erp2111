# Copy this file to .env and adjust the values.

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://erp:erp@localhost:5432/erp?schema=public"

# API server
PORT=4000
# Origin of the web app, allowed by CORS
WEB_ORIGIN=http://localhost:3000

# Auth — use long random strings in production (e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Set to true when served over HTTPS
COOKIE_SECURE=false

# First admin account created by `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@erp.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=System Administrator

# outbox = development only (emails viewable at /api/v1/dev/outbox); use smtp in production and set NODE_ENV=production
MAIL_TRANSPORT=outbox
MAIL_FROM="ERP <no-reply@localhost>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=
