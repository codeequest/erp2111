// ERP database schema — PostgreSQL via Prisma.
//
// Conventions
//  - Primary keys are UUIDs, except singletons and high-volume log tables.
//  - Table names are snake_case plural (@@map), columns snake_case (@map).
//  - Money and quantities are Decimal, NEVER Float:
//      Decimal(18,4) for quantities, unit prices and costs
//      Decimal(18,2) for document totals and payments
//  - Master data is soft-deleted with `is_active`. Business documents are never
//    deleted: they are CANCELLED (or corrected by a credit note / return).
//  - Stock is never edited by hand: every change is a row in `stock_moves`.
//    `stock_balances` is a cache updated in the same transaction.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// CORE — users, roles, permissions, auth, settings, audit
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  /// Stored lower-case (enforced by a CHECK constraint).
  username     String?    @unique
  /// Null for invited users who have not set a password yet (cannot log in).
  passwordHash String?    @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  /// Maintained by app code as `firstName + ' ' + lastName`.
  fullName     String     @map("full_name")
  phone        String?
  department   String?
  jobTitle     String?    @map("job_title")
  employeeId   String?    @map("employee_id")
  /// Custom user metadata: JSON object of string -> string.
  metadata     Json       @default("{}")
  status       UserStatus @default(PENDING)

  emailVerifiedAt    DateTime? @map("email_verified_at")
  passwordChangedAt  DateTime? @map("password_changed_at")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  mfaRequired        Boolean   @default(false) @map("mfa_required")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  /// "Locked" is derived from `locked_until > now()`, never stored as a status.
  lockedUntil        DateTime? @map("locked_until")

  deactivatedAt      DateTime? @map("deactivated_at")
  deactivatedById    String?   @map("deactivated_by_id") @db.Uuid
  deactivationReason String?   @map("deactivation_reason")
  accessReviewedAt   DateTime? @map("access_reviewed_at")
  accessReviewedById String?   @map("access_reviewed_by_id") @db.Uuid

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  deactivatedBy    User?  @relation("UserDeactivatedBy", fields: [deactivatedById], references: [id], onDelete: SetNull)
  deactivated      User[] @relation("UserDeactivatedBy")
  accessReviewedBy User?  @relation("UserAccessReviewedBy", fields: [accessReviewedById], references: [id], onDelete: SetNull)
  accessReviewed   User[] @relation("UserAccessReviewedBy")

  roles            UserRole[]        @relation("UserRoleUser")
  rolesAssigned    UserRole[]        @relation("UserRoleAssignedBy")
  sessions         Session[]
  refreshTokens    RefreshToken[]
  tokens           UserToken[]       @relation("UserTokenUser")
  tokensCreated    UserToken[]       @relation("UserTokenCreatedBy")
  mfa              UserMfa?
  mfaRecoveryCodes MfaRecoveryCode[]
  auditLogs        AuditLog[]

  stockMoves      StockMove[]
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  salesOrders     SalesOrder[]
  deliveries      Delivery[]
  customerReturns CustomerReturn[]
  invoices        Invoice[]
  payments        Payment[]

  @@index([status])
  @@index([department])
  @@map("users")
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  /// SYSTEM roles (seeded) cannot be deleted or renamed; CUSTOM roles are admin-created.
  type        RoleType @default(CUSTOM)
  /// Protected roles (Admin): name and permissions immutable, always the full catalogue.
  isProtected Boolean  @default(false) @map("is_protected")
  /// One of ROLE_COLORS in @erp/shared (slate, blue, emerald, ...).
  color       String   @default("slate")
  category    String?
  /// Optimistic locking for the role editor and the permission matrix.
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

enum RoleType {
  SYSTEM
  CUSTOM
}

/// Fixed list, seeded from packages/shared/src/permissions.ts
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  /// module.resource.action, e.g. "sales.order.confirm"
  code        String  @unique
  module      String
  resource    String
  action      String
  /// Short human label, e.g. "Deactivate users"
  label       String
  description String
  /// A role holding any sensitive permission is privileged.
  sensitive   Boolean @default(false)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  assignedById String?   @map("assigned_by_id") @db.Uuid
  /// Temporary assignment: ignored once `expires_at <= now()`.
  expiresAt    DateTime? @map("expires_at")

  user       User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// A login session. Refresh tokens rotate within it; revoking it ends every token.
model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")
  ip            String?
  userAgent     String?   @map("user_agent")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

/// Refresh tokens are stored hashed (SHA-256) and rotated on every use.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  userAgent String?   @map("user_agent")
  ip        String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

/// One-time tokens sent by email, stored hashed (SHA-256).
model UserToken {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  type        UserTokenType
  tokenHash   String        @unique @map("token_hash")
  expiresAt   DateTime      @map("expires_at")
  usedAt      DateTime?     @map("used_at")
  createdById String?       @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  user      User  @relation("UserTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("UserTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@map("user_tokens")
}

enum UserTokenType {
  INVITATION
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

/// TOTP enrolment. `secret_enc` is AES-256-GCM encrypted with MFA_ENCRYPTION_KEY.
model UserMfa {
  userId       String    @id @map("user_id") @db.Uuid
  secretEnc    String    @map("secret_enc")
  /// Null while enrolment is pending confirmation.
  enabledAt    DateTime? @map("enabled_at")
  /// Last accepted TOTP step; a code for a step <= this is rejected (replay).
  lastUsedStep Int?      @map("last_used_step")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
}

/// MFA recovery codes, argon2-hashed, shown once at enrolment.
model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

/// Single row (id = 1). Editable by admin.security.manage.
model SecurityPolicy {
  id                            Int      @id @default(1)
  passwordMinLength             Int      @default(12) @map("password_min_length")
  passwordMaxLength             Int      @default(128) @map("password_max_length")
  /// Local common-password list.
  blockBreachedPasswords        Boolean  @default(true) @map("block_breached_passwords")
  /// Optional HaveIBeenPwned k-anonymity lookup (external call).
  breachApiCheck                Boolean  @default(false) @map("breach_api_check")
  lockoutThreshold              Int      @default(5) @map("lockout_threshold")
  lockoutMinutes                Int      @default(15) @map("lockout_minutes")
  invitationTtlHours            Int      @default(72) @map("invitation_ttl_hours")
  resetTtlMinutes               Int      @default(60) @map("reset_ttl_minutes")
  requireMfaForPrivileged       Boolean  @default(true) @map("require_mfa_for_privileged")
  accessReviewDays              Int      @default(90) @map("access_review_days")
  dormantDays                   Int      @default(60) @map("dormant_days")
  revokeSessionsOnPasswordReset Boolean  @default(true) @map("revoke_sessions_on_password_reset")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  @@map("security_policies")
}

/// Single row (id = 1).
model CompanySettings {
  id                 Int      @id @default(1)
  name               String
  legalName          String?  @map("legal_name")
  taxId              String?  @map("tax_id")
  address            String?
  phone              String?
  email              String?
  logoUrl            String?  @map("logo_url")
  /// ISO 4217 code of the base currency
  currency           String   @default("USD") @db.VarChar(3)
  defaultTaxRateId   String?  @map("default_tax_rate_id") @db.Uuid
  allowNegativeStock Boolean  @default(false) @map("allow_negative_stock")
  updatedAt          DateTime @updatedAt @map("updated_at")

  defaultTaxRate TaxRate? @relation(fields: [defaultTaxRateId], references: [id])

  @@map("company_settings")
}

/// Gap-free document numbering, e.g. INV-2026-00001.
/// Increment `next_number` with SELECT ... FOR UPDATE inside the document's transaction.
model DocumentSequence {
  id         String       @id @default(uuid()) @db.Uuid
  docType    DocumentType @map("doc_type")
  year       Int
  prefix     String
  nextNumber Int          @default(1) @map("next_number")
  padding    Int          @default(5)

  @@unique([docType, year])
  @@map("document_sequences")
}

/// Append-only: a database trigger rejects UPDATE and DELETE.
model AuditLog {
  id          BigInt      @id @default(autoincrement())
  userId      String?     @map("user_id") @db.Uuid
  /// e.g. "create", "update", "confirm", "post", "cancel", "login"
  action      String
  /// e.g. "SalesOrder", "Product", "User"
  entity      String
  entityId    String?     @map("entity_id")
  /// Name / email of the target at the time of the event.
  targetLabel String?     @map("target_label")
  result      AuditResult @default(SUCCESS)
  reason      String?
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?     @map("user_agent")
  createdAt   DateTime    @default(now()) @map("created_at")

  // Users are never deleted; RESTRICT keeps the trail intact.
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@index([result])
  @@map("audit_logs")
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

/// Outgoing emails. `body` is stored only when the dev transport is active.
model EmailOutbox {
  id        String      @id @default(uuid()) @db.Uuid
  to        String
  template  String
  subject   String
  status    EmailStatus @default(QUEUED)
  error     String?
  body      String?
  createdAt DateTime    @default(now()) @map("created_at")
  sentAt    DateTime?   @map("sent_at")

  @@index([status])
  @@map("email_outbox")
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

enum DocumentType {
  PURCHASE_ORDER
  GOODS_RECEIPT
  QUOTATION
  SALES_ORDER
  DELIVERY
  CUSTOMER_RETURN
  CUSTOMER_INVOICE
  CUSTOMER_CREDIT_NOTE
  SUPPLIER_BILL
  SUPPLIER_CREDIT_NOTE
  PAYMENT_IN
  PAYMENT_OUT
  STOCK_ADJUSTMENT
  STOCK_TRANSFER
}

// ─────────────────────────────────────────────────────────────────────────────
// INVENTORY — products, units, warehouses, stock ledger
// ─────────────────────────────────────────────────────────────────────────────

model TaxRate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  /// Percentage, e.g. 19.00
  rate      Decimal  @db.Decimal(5, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  products        Product[]
  companyDefaults CompanySettings[]
  invoiceLines    InvoiceLine[]

  @@map("tax_rates")
}

model Unit {
  id   String @id @default(uuid()) @db.Uuid
  /// e.g. PCS, CTN, KG
  code String @unique
  name String

  baseProducts       Product[]
  productUnits       ProductUnit[]
  priceListItems     PriceListItem[]
  purchaseOrderLines PurchaseOrderLine[]
  salesOrderLines    SalesOrderLine[]

  @@map("units")
}

model Category {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  parentId String? @map("parent_id") @db.Uuid
  isActive Boolean @default(true) @map("is_active")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([parentId, name])
  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  sku         String   @unique
  barcode     String?  @unique
  name        String
  description String?
  categoryId  String?  @map("category_id") @db.Uuid
  /// Stock is always kept in the base unit
  baseUnitId  String   @map("base_unit_id") @db.Uuid
  taxRateId   String?  @map("tax_rate_id") @db.Uuid
  salePrice   Decimal  @default(0) @map("sale_price") @db.Decimal(18, 4)
  /// Weighted average cost in base unit — visible only with inventory.cost.view
  averageCost Decimal  @default(0) @map("average_cost") @db.Decimal(18, 4)
  /// Low-stock alert threshold (base unit)
  minStock    Decimal  @default(0) @map("min_stock") @db.Decimal(18, 4)
  /// File name of the product photo in UPLOAD_DIR/products (random, unguessable)
  imageFile   String?  @map("image_file")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category? @relation(fields: [categoryId], references: [id])
  baseUnit Unit      @relation(fields: [baseUnitId], references: [id])
  taxRate  TaxRate?  @relation(fields: [taxRateId], references: [id])

  units               ProductUnit[]
  priceListItems      PriceListItem[]
  stockMoves          StockMove[]
  stockBalances       StockBalance[]
  purchaseOrderLines  PurchaseOrderLine[]
  goodsReceiptLines   GoodsReceiptLine[]
  salesOrderLines     SalesOrderLine[]
  deliveryLines       DeliveryLine[]
  customerReturnLines CustomerReturnLine[]
  invoiceLines        InvoiceLine[]

  @@index([name])
  @@index([categoryId])
  @@map("products")
}

/// Alternative units for buying / selling, e.g. 1 CTN = 24 PCS (factor = 24).
model ProductUnit {
  id          String  @id @default(uuid()) @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  unitId      String  @map("unit_id") @db.Uuid
  /// How many base units are in one of this unit
  factor      Decimal @db.Decimal(18, 4)
  forPurchase Boolean @default(true) @map("for_purchase")
  forSale     Boolean @default(true) @map("for_sale")
  barcode     String? @unique

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit    Unit    @relation(fields: [unitId], references: [id])

  @@unique([productId, unitId])
  @@map("product_units")
}

/// A named set of selling prices, e.g. "Wholesale" or "Retail".
/// A product without its own price in the list gets
/// sale price x pack factor x (1 + adjustPercent / 100).
model PriceList {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  description   String?
  /// e.g. -10.00 for 10 % below the normal sale price; 0 = same price
  adjustPercent Decimal  @default(0) @map("adjust_percent") @db.Decimal(7, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  items PriceListItem[]

  @@map("price_lists")
}

/// A fixed price for one product in one unit (base unit or a pack size) in a price list.
model PriceListItem {
  id          String   @id @default(uuid()) @db.Uuid
  priceListId String   @map("price_list_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  unitId      String   @map("unit_id") @db.Uuid
  price       Decimal  @db.Decimal(18, 4)
  updatedAt   DateTime @updatedAt @map("updated_at")

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit      Unit      @relation(fields: [unitId], references: [id])

  @@unique([priceListId, productId, unitId])
  @@index([productId])
  @@map("price_list_items")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  stockMoves      StockMove[]
  stockBalances   StockBalance[]
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  salesOrders     SalesOrder[]
  deliveries      Delivery[]
  customerReturns CustomerReturn[]

  @@map("warehouses")
}

enum StockMoveType {
  OPENING
  RECEIPT
  DELIVERY
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  CUSTOMER_RETURN
}

/// The stock ledger. Append-only: never update or delete rows.
model StockMove {
  id          String        @id @default(uuid()) @db.Uuid
  productId   String        @map("product_id") @db.Uuid
  warehouseId String        @map("warehouse_id") @db.Uuid
  type        StockMoveType
  /// Signed quantity in base unit: + in, - out
  quantity    Decimal       @db.Decimal(18, 4)
  /// Cost per base unit at the time of the move
  unitCost    Decimal       @default(0) @map("unit_cost") @db.Decimal(18, 4)
  /// Source document, e.g. ("GoodsReceipt", <id>) — for traceability
  sourceType  String?       @map("source_type")
  sourceId    String?       @map("source_id") @db.Uuid
  /// Human-readable reference, e.g. "GR-2026-00012"
  reference   String?
  /// Required for adjustments
  reason      String?
  /// Groups the OUT and IN rows of one transfer
  transferId  String?       @map("transfer_id") @db.Uuid
  createdById String        @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([productId, warehouseId, createdAt])
  @@index([sourceType, sourceId])
  @@index([transferId])
  @@map("stock_moves")
}

/// Cached on-hand quantity per product and warehouse = SUM(stock_moves.quantity).
model StockBalance {
  productId   String   @map("product_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt   DateTime @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@id([productId, warehouseId])
  @@map("stock_balances")
}

// ─────────────────────────────────────────────────────────────────────────────
// PARTNERS — suppliers and customers
// ─────────────────────────────────────────────────────────────────────────────

model Supplier {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  name            String
  email           String?
  phone           String?
  address         String?
  taxId           String?  @map("tax_id")
  paymentTermDays Int      @default(0) @map("payment_term_days")
  notes           String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  payments       Payment[]

  @@index([name])
  @@map("suppliers")
}

model Customer {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  name            String
  email           String?
  phone           String?
  address         String?
  taxId           String?  @map("tax_id")
  paymentTermDays Int      @default(0) @map("payment_term_days")
  /// null = no limit
  creditLimit     Decimal? @map("credit_limit") @db.Decimal(18, 2)
  notes           String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  salesOrders     SalesOrder[]
  customerReturns CustomerReturn[]
  invoices        Invoice[]
  payments        Payment[]

  @@index([name])
  @@map("customers")
}

enum DiscountType {
  PERCENT
  AMOUNT
}

// ─────────────────────────────────────────────────────────────────────────────
// PURCHASING — purchase orders and goods receipts
// ─────────────────────────────────────────────────────────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id            String              @id @default(uuid()) @db.Uuid
  number        String              @unique
  supplierId    String              @map("supplier_id") @db.Uuid
  /// Where the goods will be received
  warehouseId   String              @map("warehouse_id") @db.Uuid
  status        PurchaseOrderStatus @default(DRAFT)
  orderDate     DateTime            @default(now()) @map("order_date") @db.Date
  expectedDate  DateTime?           @map("expected_date") @db.Date
  notes         String?
  subtotal      Decimal             @default(0) @db.Decimal(18, 2)
  discountTotal Decimal             @default(0) @map("discount_total") @db.Decimal(18, 2)
  taxTotal      Decimal             @default(0) @map("tax_total") @db.Decimal(18, 2)
  total         Decimal             @default(0) @db.Decimal(18, 2)
  confirmedAt   DateTime?           @map("confirmed_at")
  createdById   String              @map("created_by_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  supplier  Supplier  @relation(fields: [supplierId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]
  invoices Invoice[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  lineNo          Int     @map("line_no")
  productId       String  @map("product_id") @db.Uuid
  /// Unit used on this line (may differ from the base unit)
  unitId          String  @map("unit_id") @db.Uuid
  /// Base units per line unit, copied at order time
  unitFactor      Decimal @default(1) @map("unit_factor") @db.Decimal(18, 4)
  quantity        Decimal @db.Decimal(18, 4)
  unitPrice       Decimal @map("unit_price") @db.Decimal(18, 4)
  discountPct     Decimal @default(0) @map("discount_pct") @db.Decimal(5, 2)
  /// Tax % copied at order time
  taxRate         Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineTotal       Decimal @default(0) @map("line_total") @db.Decimal(18, 2)
  /// In line units
  receivedQty     Decimal @default(0) @map("received_qty") @db.Decimal(18, 4)

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product            @relation(fields: [productId], references: [id])
  unit          Unit               @relation(fields: [unitId], references: [id])
  receiptLines  GoodsReceiptLine[]

  @@unique([purchaseOrderId, lineNo])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  number          String   @unique
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  warehouseId     String   @map("warehouse_id") @db.Uuid
  receivedAt      DateTime @default(now()) @map("received_at")
  notes           String?
  createdById     String   @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  createdBy     User               @relation(fields: [createdById], references: [id])
  lines         GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String  @id @default(uuid()) @db.Uuid
  goodsReceiptId      String  @map("goods_receipt_id") @db.Uuid
  purchaseOrderLineId String  @map("purchase_order_line_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  /// In the PO line's unit
  quantity            Decimal @db.Decimal(18, 4)

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  product           Product           @relation(fields: [productId], references: [id])

  @@map("goods_receipt_lines")
}

// ─────────────────────────────────────────────────────────────────────────────
// SALES — quotations / orders, deliveries, returns
// ─────────────────────────────────────────────────────────────────────────────

enum SalesOrderStatus {
  /// A quotation is a sales order that is not confirmed yet
  QUOTATION
  CONFIRMED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

model SalesOrder {
  id             String           @id @default(uuid()) @db.Uuid
  /// QUO-… while a quotation, SO-… once confirmed
  number         String           @unique
  quotationNo    String?          @unique @map("quotation_no")
  customerId     String           @map("customer_id") @db.Uuid
  /// Warehouse the goods ship from
  warehouseId    String           @map("warehouse_id") @db.Uuid
  status         SalesOrderStatus @default(QUOTATION)
  orderDate      DateTime         @default(now()) @map("order_date") @db.Date
  validUntil     DateTime?        @map("valid_until") @db.Date
  discountType   DiscountType?    @map("discount_type")
  discountValue  Decimal          @default(0) @map("discount_value") @db.Decimal(18, 4)
  subtotal       Decimal          @default(0) @db.Decimal(18, 2)
  discountTotal  Decimal          @default(0) @map("discount_total") @db.Decimal(18, 2)
  taxTotal       Decimal          @default(0) @map("tax_total") @db.Decimal(18, 2)
  total          Decimal          @default(0) @db.Decimal(18, 2)
  notes          String?
  confirmedAt    DateTime?        @map("confirmed_at")
  /// Set when confirmed above the credit limit (needs sales.credit.override)
  creditOverride Boolean          @default(false) @map("credit_override")
  createdById    String           @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  customer  Customer  @relation(fields: [customerId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  lines      SalesOrderLine[]
  deliveries Delivery[]
  returns    CustomerReturn[]
  invoices   Invoice[]

  @@index([customerId])
  @@index([status])
  @@map("sales_orders")
}

model SalesOrderLine {
  id           String  @id @default(uuid()) @db.Uuid
  salesOrderId String  @map("sales_order_id") @db.Uuid
  lineNo       Int     @map("line_no")
  productId    String  @map("product_id") @db.Uuid
  unitId       String  @map("unit_id") @db.Uuid
  unitFactor   Decimal @default(1) @map("unit_factor") @db.Decimal(18, 4)
  quantity     Decimal @db.Decimal(18, 4)
  unitPrice    Decimal @map("unit_price") @db.Decimal(18, 4)
  discountPct  Decimal @default(0) @map("discount_pct") @db.Decimal(5, 2)
  taxRate      Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineTotal    Decimal @default(0) @map("line_total") @db.Decimal(18, 2)
  deliveredQty Decimal @default(0) @map("delivered_qty") @db.Decimal(18, 4)

  salesOrder    SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id])
  unit          Unit           @relation(fields: [unitId], references: [id])
  deliveryLines DeliveryLine[]

  @@unique([salesOrderId, lineNo])
  @@map("sales_order_lines")
}

model Delivery {
  id           String   @id @default(uuid()) @db.Uuid
  number       String   @unique
  salesOrderId String   @map("sales_order_id") @db.Uuid
  warehouseId  String   @map("warehouse_id") @db.Uuid
  deliveredAt  DateTime @default(now()) @map("delivered_at")
  notes        String?
  createdById  String   @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  salesOrder SalesOrder     @relation(fields: [salesOrderId], references: [id])
  warehouse  Warehouse      @relation(fields: [warehouseId], references: [id])
  createdBy  User           @relation(fields: [createdById], references: [id])
  lines      DeliveryLine[]

  @@index([salesOrderId])
  @@map("deliveries")
}

model DeliveryLine {
  id               String  @id @default(uuid()) @db.Uuid
  deliveryId       String  @map("delivery_id") @db.Uuid
  salesOrderLineId String  @map("sales_order_line_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  quantity         Decimal @db.Decimal(18, 4)

  delivery       Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  salesOrderLine SalesOrderLine @relation(fields: [salesOrderLineId], references: [id])
  product        Product        @relation(fields: [productId], references: [id])

  @@map("delivery_lines")
}

model CustomerReturn {
  id           String   @id @default(uuid()) @db.Uuid
  number       String   @unique
  customerId   String   @map("customer_id") @db.Uuid
  salesOrderId String?  @map("sales_order_id") @db.Uuid
  warehouseId  String   @map("warehouse_id") @db.Uuid
  returnedAt   DateTime @default(now()) @map("returned_at")
  reason       String?
  createdById  String   @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  customer   Customer             @relation(fields: [customerId], references: [id])
  salesOrder SalesOrder?          @relation(fields: [salesOrderId], references: [id])
  warehouse  Warehouse            @relation(fields: [warehouseId], references: [id])
  createdBy  User                 @relation(fields: [createdById], references: [id])
  lines      CustomerReturnLine[]
  creditNote Invoice?

  @@map("customer_returns")
}

model CustomerReturnLine {
  id        String  @id @default(uuid()) @db.Uuid
  returnId  String  @map("return_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  /// Base unit
  quantity  Decimal @db.Decimal(18, 4)
  unitPrice Decimal @map("unit_price") @db.Decimal(18, 4)

  customerReturn CustomerReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])

  @@map("customer_return_lines")
}

// ─────────────────────────────────────────────────────────────────────────────
// INVOICING — invoices, bills, credit notes, payments
// ─────────────────────────────────────────────────────────────────────────────

enum InvoiceType {
  CUSTOMER_INVOICE
  CUSTOMER_CREDIT_NOTE
  SUPPLIER_BILL
  SUPPLIER_CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  /// Posted documents are immutable
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

/// One table for all four invoice types: customer side uses customer_id,
/// supplier side uses supplier_id.
model Invoice {
  id                String        @id @default(uuid()) @db.Uuid
  /// Assigned when posted; drafts use a temporary "DRAFT-…" number
  number            String        @unique
  type              InvoiceType
  status            InvoiceStatus @default(DRAFT)
  customerId        String?       @map("customer_id") @db.Uuid
  supplierId        String?       @map("supplier_id") @db.Uuid
  /// Supplier's own bill number
  supplierRef       String?       @map("supplier_ref")
  salesOrderId      String?       @map("sales_order_id") @db.Uuid
  purchaseOrderId   String?       @map("purchase_order_id") @db.Uuid
  customerReturnId  String?       @unique @map("customer_return_id") @db.Uuid
  /// For credit notes: the invoice being corrected
  originalInvoiceId String?       @map("original_invoice_id") @db.Uuid
  issueDate         DateTime      @default(now()) @map("issue_date") @db.Date
  dueDate           DateTime?     @map("due_date") @db.Date
  currency          String        @db.VarChar(3)
  discountType      DiscountType? @map("discount_type")
  discountValue     Decimal       @default(0) @map("discount_value") @db.Decimal(18, 4)
  subtotal          Decimal       @default(0) @db.Decimal(18, 2)
  discountTotal     Decimal       @default(0) @map("discount_total") @db.Decimal(18, 2)
  taxTotal          Decimal       @default(0) @map("tax_total") @db.Decimal(18, 2)
  total             Decimal       @default(0) @db.Decimal(18, 2)
  amountPaid        Decimal       @default(0) @map("amount_paid") @db.Decimal(18, 2)
  notes             String?
  postedAt          DateTime?     @map("posted_at")
  createdById       String        @map("created_by_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  customer        Customer?       @relation(fields: [customerId], references: [id])
  supplier        Supplier?       @relation(fields: [supplierId], references: [id])
  salesOrder      SalesOrder?     @relation(fields: [salesOrderId], references: [id])
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  customerReturn  CustomerReturn? @relation(fields: [customerReturnId], references: [id])
  originalInvoice Invoice?        @relation("CreditNotes", fields: [originalInvoiceId], references: [id])
  creditNotes     Invoice[]       @relation("CreditNotes")
  createdBy       User            @relation(fields: [createdById], references: [id])

  lines       InvoiceLine[]
  allocations PaymentAllocation[]

  @@index([type, status])
  @@index([customerId])
  @@index([supplierId])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id           String  @id @default(uuid()) @db.Uuid
  invoiceId    String  @map("invoice_id") @db.Uuid
  lineNo       Int     @map("line_no")
  /// Optional: a line can be a free-text service / fee
  productId    String? @map("product_id") @db.Uuid
  description  String
  quantity     Decimal @db.Decimal(18, 4)
  unitPrice    Decimal @map("unit_price") @db.Decimal(18, 4)
  discountPct  Decimal @default(0) @map("discount_pct") @db.Decimal(5, 2)
  taxRateId    String? @map("tax_rate_id") @db.Uuid
  /// Tax % copied at invoice time
  taxRate      Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineSubtotal Decimal @default(0) @map("line_subtotal") @db.Decimal(18, 2)
  lineTax      Decimal @default(0) @map("line_tax") @db.Decimal(18, 2)
  lineTotal    Decimal @default(0) @map("line_total") @db.Decimal(18, 2)

  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id])
  taxRateRef TaxRate? @relation(fields: [taxRateId], references: [id])

  @@unique([invoiceId, lineNo])
  @@map("invoice_lines")
}

enum PaymentDirection {
  /// Money received from a customer
  IN
  /// Money paid to a supplier
  OUT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

model Payment {
  id          String           @id @default(uuid()) @db.Uuid
  number      String           @unique
  direction   PaymentDirection
  method      PaymentMethod
  amount      Decimal          @db.Decimal(18, 2)
  paidAt      DateTime         @default(now()) @map("paid_at") @db.Date
  customerId  String?          @map("customer_id") @db.Uuid
  supplierId  String?          @map("supplier_id") @db.Uuid
  /// Cheque number, bank reference…
  reference   String?
  notes       String?
  createdById String           @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")

  customer    Customer?           @relation(fields: [customerId], references: [id])
  supplier    Supplier?           @relation(fields: [supplierId], references: [id])
  createdBy   User                @relation(fields: [createdById], references: [id])
  allocations PaymentAllocation[]

  @@index([customerId])
  @@index([supplierId])
  @@map("payments")
}

/// Splits one payment across one or more invoices (partial payments allowed).
model PaymentAllocation {
  paymentId String  @map("payment_id") @db.Uuid
  invoiceId String  @map("invoice_id") @db.Uuid
  amount    Decimal @db.Decimal(18, 2)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@id([paymentId, invoiceId])
  @@map("payment_allocations")
}
