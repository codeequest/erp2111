{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "\\.e2e-spec\\.ts$",
  "transform": { "^.+\\.ts$": "ts-jest" },
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/test/e2e/setup.ts",
  "setupFiles": ["<rootDir>/test/e2e/env.ts"],
  "maxWorkers": 1,
  "testTimeout": 60000
}
