{
  "name": "erp",
  "private": true,
  "version": "0.1.0",
  "description": "ERP for a trading / retail company — Next.js + NestJS + PostgreSQL (Prisma)",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @erp/shared build && pnpm -r --parallel --filter @erp/api --filter @erp/web dev",
    "dev:api": "pnpm --filter @erp/shared build && pnpm --filter @erp/api dev",
    "dev:web": "pnpm --filter @erp/shared build && pnpm --filter @erp/web dev",
    "build": "pnpm --filter @erp/shared build && pnpm --filter @erp/api build && pnpm --filter @erp/web build",
    "typecheck": "pnpm --filter @erp/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @erp/shared build && pnpm --filter @erp/api test",
    "format": "prettier --write .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @erp/api prisma:migrate",
    "db:seed": "pnpm --filter @erp/shared build && pnpm --filter @erp/api prisma:seed",
    "db:reset": "pnpm --filter @erp/shared build && pnpm --filter @erp/api prisma:reset",
    "db:studio": "pnpm --filter @erp/api prisma:studio"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
